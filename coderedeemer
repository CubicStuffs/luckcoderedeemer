local function normalizeCode(s) return (tostring(s or "")):match("^%s*(.-)%s*$") or "" end
local function normalizeRiddleText(t)
    t = tostring(t or ""):lower()
    t = t:gsub("1st","first"):gsub("2nd","second"):gsub("3rd","third"):gsub("4th","fourth")
    t = t:gsub("[^%w%s]"," "):gsub("%s+"," ")
    return t:match("^%s*(.-)%s*$") or ""
end
local function stemRiddleWord(w)
    w = tostring(w or ""):lower()
    if #w>4 and w:sub(-3)=="ing" then w=w:sub(1,-4) end
    if #w>4 and w:sub(-2)=="ed" then w=w:sub(1,-3) end
    if #w>4 and w:sub(-2)=="es" then w=w:sub(1,-3) end
    if #w>3 and w:sub(-1)=="s" then w=w:sub(1,-2) end
    local al={original="og",earliest="first",newest="latest",recent="latest",made="add",added="add",created="add",born="birth",birthday="birth",called="name"}
    return al[w] or w
end
local FILL = {what=true,is=true,the=true,a=true,an=true,["do"]=true,does=true,did=true,you=true,are=true,was=true,were=true,am=true,i=true,my=true,me=true,we=true,our=true,of=true,to=true,["in"]=true,on=true,at=true,["and"]=true,["or"]=true,have=true,has=true,it=true,["for"]=true,how=true,where=true,who=true,when=true,which=true,can=true,s=true,will=true,would=true,could=true,please=true}
local function riddleWords(t)
    local w={}
    for word in normalizeRiddleText(t):gmatch("%w+") do
        local s=stemRiddleWord(word)
        if s~="" and not FILL[s] and not s:match("^%d+$") then w[s]=true end
    end
    if w.brainrot and w.god then w.brainrotgod=true end
    if w.brainrotgod then w.brainrot=true; w.god=true end
    return w
end
local function riddleMatch(msg, pat)
    local ph=normalizeRiddleText(pat)
    if msg:find(ph,1,true) then return true end
    if msg:gsub("%s+",""):find(ph:gsub("%s+",""),1,true) then return true end
    local ww,rr=riddleWords(pat),riddleWords(msg)
    local n=0
    for w in pairs(ww) do n+=1; if not rr[w] then return false end end
    return n>0
end
local function extractNum(msg, ans)
    local nums={}
    for num in tostring(ans or ""):gmatch("%d+") do nums[num]=true end
    local last
    for num in tostring(msg or ""):gmatch("%d+") do if not nums[num] then last=num end end
    return last
end
local function solveOfflineRiddle(message)
    if not message or message=="" then return nil end
    local combined={}
    local function split(str)
        local r,l,p={},str:lower(),1
        while true do
            local s,e=l:find(" and ",p,true)
            if not s then local rem=str:sub(p); if rem~="" then table.insert(r,rem) end; break end
            local pp=str:sub(p,s-1); if pp~="" then table.insert(r,pp) end
            p=e+1
        end
        return r
    end
    local temp=message:gsub("%s*[&,]"," and ")
    local parts=split(temp)
    if #parts>1 then
        local found=false
        for _,part in ipairs(parts) do
            local trimmed=part:match("^%s*(.-)%s*$")
            if trimmed~="" and #trimmed>2 then
                local np=normalizeRiddleText(trimmed)
                local hit=false
                for _,e in ipairs(BRAINROT_KNOWLEDGE) do
                    for _,pt in ipairs(e.p) do
                        if riddleMatch(np,pt) then
                            table.insert(combined,e.a:gsub("%s+",""):upper()); hit=true; found=true; break
                        end
                    end
                    if hit then break end
                end
            end
        end
        if found and #combined>1 then
            local c=table.concat(combined)
            local suf=extractNum(message,"")
            if suf and #suf>0 then c=c..suf end
            return c,suf
        end
    end
    local normalized=normalizeRiddleText(message)
    if normalized=="" then return nil end
    for _,e in ipairs(BRAINROT_KNOWLEDGE) do
        for _,pt in ipairs(e.p) do
            if riddleMatch(normalized,pt) then
                return e.a:gsub("%s+",""):upper(), extractNum(message,e.a)
            end
        end
    end
    if normalized:find("who am i",1,true) or normalized:find("what am i",1,true) then
        return "PLAYER", extractNum(message,"player")
    end
    if normalized:find("yes or no",1,true) and normalized:find("brainrot",1,true) then
        return "YES", extractNum(message,"yes")
    end
    return nil
end

local function solveRiddle(message, seq)
    if not _enabled or not _riddleSolver then return end
    _solving += 1
    task.spawn(function()
        task.wait()
        _solving = math.max(0,_solving-1)
        if not _enabled or not _riddleSolver then return end
        local ans,suf=solveOfflineRiddle(message)
        local top=normalizeCode(ans):gsub("%s+","")
        if top and #top>0 and suf and #suf>0 then top=top..suf end
        if top and #top>0 and seq>=_lastTypedSeq then
            _lastTypedSeq=seq; _solvedCount+=1
            if setStatus then setStatus("Answer: "..top, COLORS and COLORS.Green or Color3.fromRGB(0,255,0)) end
            if flashCode then flashCode(top) end
            appendToBox(top)
        elseif not top or #top==0 then
            if setStatus then setStatus("Answer: not found", COLORS and COLORS.Red or Color3.fromRGB(255,0,0)) end
        end
    end)
end

