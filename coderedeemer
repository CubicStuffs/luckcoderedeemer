local function isVisibleChain(i)
    local c=i
    while c do
        if c:IsA("GuiObject") and not c.Visible then return false end
        if c:IsA("ScreenGui") then return c.Enabled end
        c=c.Parent
    end
    return true
end
local function findAllTextBoxes(pg)
    local b={}
    for _,g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOurGui(g) then
            for _,d in ipairs(g:GetDescendants()) do
                if d:IsA("TextBox") and not isOurGui(d) then b[#b+1]=d end
            end
        end
    end
    return b
end
local function findCodeButtons(pg)
    local btns={}
    for _,g in ipairs(pg:GetChildren()) do
        if g:IsA("ScreenGui") and g.Enabled and not isOurGui(g) then
            for _,d in ipairs(g:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) then
                    local n,pn=d.Name:lower(),(d.Parent and d.Parent.Name or ""):lower()
                    if (n:find("code") or n:find("redeem") or pn:find("code") or pn:find("redeem")) and isVisibleChain(d) then
                        btns[#btns+1]=d
                    end
                end
            end
        end
    end
    return btns
end
local function clickButton(btn)
    if not btn then return false end
    local m={}
    m[#m+1]=function() btn.MouseButton1Click:Fire() end
    m[#m+1]=function() btn.Activated:Fire() end
    if typeof(firesignal)=="function" then
        m[#m+1]=function() firesignal(btn.MouseButton1Click) end
        m[#m+1]=function() firesignal(btn.Activated) end
    end
    if typeof(getconns)=="function" then
        m[#m+1]=function()
            local ok,cs=pcall(getconns,btn.MouseButton1Click)
            if ok and type(cs)=="table" then for _,c in ipairs(cs) do pcall(function() c:Fire() end) end end
        end
    end
    if typeof(fireclick)=="function" then m[#m+1]=function() fireclick(btn) end end
    local ok=false
    for _,f in ipairs(m) do ok=pcall(f) or ok end
    return ok
end
local function fireBoxFocusLost(box)
    if not box then return false end
    local fired=false
    if typeof(firesignal)=="function" then fired=pcall(firesignal,box.FocusLost,true) or fired end
    if typeof(getconns)=="function" then
        local ok,cs=pcall(getconns,box.FocusLost)
        if ok and type(cs)=="table" then
            for _,c in ipairs(cs) do
                local f=pcall(function() if c.Enabled~=false then c:Fire(true) end end)
                fired=fired or f
            end
        end
    end
    return fired
end
typeAndSubmitCode = function(code)
    local pg=playerGui or player:FindFirstChildOfClass("PlayerGui")
    if not pg then return false,"no gui" end
    local cg=pg:FindFirstChild("Codes")
    if cg then
        if cg:IsA("ScreenGui") then cg.Enabled=true end
        local cf=cg:FindFirstChild("Codes") or cg
        if cf then
            if cf:IsA("GuiObject") then cf.Visible=true end
            local cur=cf
            while cur and cur~=cg do if cur:IsA("GuiObject") then cur.Visible=true end; cur=cur.Parent end
            local box,btn
            for _,d in ipairs(cf:GetDescendants()) do if d:IsA("TextBox") and not isOurGui(d) then box=d; break end end
            for _,d in ipairs(cf:GetDescendants()) do
                if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) then
                    local n,txt=d.Name:lower(),"" pcall(function() txt=d.Text:lower() end)
                    if n:find("submit") or txt:find("submit") or n:find("redeem") or txt:find("redeem") or n:find("claim") or txt:find("confirm") or n:find("enter") then btn=d; break end
                end
            end
            if not btn then
                for _,d in ipairs(cf:GetDescendants()) do
                    if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) then
                        local n=d.Name:lower()
                        if not n:find("close") and not n:find("x") and not n:find("toggle") then btn=d; break end
                    end
                end
            end
            if box then
                pcall(function() box.Text=code end)
                task.wait(0.05)
                if btn then clickButton(btn) end
                fireBoxFocusLost(box)
                return true,"codes"
            end
        end
    end
    for _,b in ipairs(findCodeButtons(pg)) do clickButton(b); task.wait(0.05) end
    task.wait(0.2)
    local box=nil
    local dl=tick()+2
    while tick()<dl do
        local all=findAllTextBoxes(pg)
        for _,d in ipairs(all) do
            if isVisibleChain(d) then
                local n,pn=d.Name:lower(),(d.Parent and d.Parent.Name or ""):lower()
                if n:find("code") or pn:find("code") or n:find("redeem") or pn:find("redeem") or n:find("input") or pn:find("textbox") or n:find("enter") then box=d; break end
            end
        end
        if not box then for _,d in ipairs(all) do if isVisibleChain(d) then box=d; break end end end
        if box then break end
        task.wait(0.1)
    end
    if not box then return false,"no box" end
    pcall(function() box.Text=code end)
    task.wait(0.05)
    local rb=nil
    local names={"submit","redeem","claim","confirm","enter","send","apply","ok","use","go","check"}
    local p=box.Parent
    for _=1,8 do
        if not p then break end
        for _,d in ipairs(p:GetDescendants()) do
            if (d:IsA("TextButton") or d:IsA("ImageButton")) and not isOurGui(d) and d~=box then
                local n,txt=d.Name:lower(),"" pcall(function() txt=d.Text:lower() end)
                for _,sn in ipairs(names) do
                    if n:find(sn) or txt:find(sn) then
                        if isVisibleChain(d) then rb=d; break end
                    end
                end
                if rb then break end
            end
        end
        if rb then break end
        p=p.Parent
    end
    if rb then clickButton(rb) end
    fireBoxFocusLost(box)
    return true,"dynamic"
end
