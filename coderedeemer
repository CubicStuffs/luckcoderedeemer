local function resetPasteCounter() _capturedParts = {} end
clearAceCapture = function() _capturedParts = {} end

local function clearBoxWatchers()
    if _boxTextConn then pcall(function() _boxTextConn:Disconnect() end) end
    if _boxAncestryConn then pcall(function() _boxAncestryConn:Disconnect() end) end
    _boxTextConn=nil; _boxAncestryConn=nil; _lastWatchedBox=nil
end
local function watchBoxForBlankReset(box)
    if not box or _lastWatchedBox == box then return end
    clearBoxWatchers(); _lastWatchedBox = box
    if box.Text ~= "" then _lastNonBlankBoxText = box.Text end
    _boxTextConn = box:GetPropertyChangedSignal("Text"):Connect(function()
        if box.Text == "" then resetPasteCounter()
        else _lastNonBlankBoxText = box.Text end
    end)
    _boxAncestryConn = box.AncestryChanged:Connect(function(_, parent)
        if not parent then resetPasteCounter(); clearBoxWatchers() end
    end)
end

UserInputService.TextBoxFocused:Connect(function(box)
    if box:IsDescendantOf(GUI) then return end
    if box ~= aceCodeBox() then return end
    _focused = box; _lastBox = box
    watchBoxForBlankReset(box)
    if _enabled then setStatus("Code box focused", COLORS.Green) end
end)
UserInputService.TextBoxFocusReleased:Connect(function(box)
    if box:IsDescendantOf(GUI) then return end
    local cb = aceCodeBox()
    if box ~= cb and box ~= _lastBox then return end
    if _retypeInvalid and rememberPendingSubmission and (box == cb or box == _lastBox) then
        local st = box.Text ~= "" and box.Text or _lastNonBlankBoxText
        rememberPendingSubmission(box, st, false)
    end
    if _focused == box then _focused = nil; if _enabled then setStatus("Ready", COLORS.Green) end end
end)

clearPendingSubmission = function()
    _pendingRejectedToken += 1
    _pendingRejectedText = nil; _pendingRejectedBox = nil; _pendingRejectedUntil = 0
end
rememberPendingSubmission = function(box, text, replaceExisting)
    if not text or text == "" then return end
    if not replaceExisting and _pendingRejectedText and os.clock() <= _pendingRejectedUntil then return end
    _pendingRejectedToken += 1
    local token = _pendingRejectedToken
    _pendingRejectedText = text; _pendingRejectedBox = box
    _pendingRejectedUntil = os.clock() + 8
    task.delay(8, function() if token == _pendingRejectedToken then clearPendingSubmission() end end)
end
local function restoreRejectedText(box, prevText)
    if not _retypeInvalid or not prevText or prevText == "" then return false end
    RunService.Heartbeat:Wait()
    local rb = aceCodeBox() or box
    if not rb or not isVisibleChain(rb) then return false end
    local ok = pcall(function() rb.Text = prevText end)
    if ok then _lastBox = rb; watchBoxForBlankReset(rb) end
    return ok
end

handleRedemptionFeedback = function(text, fbObj)
    if fbObj and fbObj:IsDescendantOf(GUI) then return end
    local lower = tostring(text or ""):lower()
    if lower == "" then return end

    local success = lower:find("code redeemed", 1, true)
        or lower:find("redeemed!", 1, true)
        or lower:find("successfully", 1, true)
        or lower:find("you got", 1, true)
        or lower:find("congrats", 1, true)
        or lower:find("congratulations", 1, true)
        or (lower:find("thank", 1, true) and lower:find("code", 1, true))

    if success and #_capturedParts > 0 then
        local finalCode = table.concat(_capturedParts)
        setStatus("✓ Accepted: "..finalCode, COLORS.Green)
        _capturedParts = {}
        _lastStatusMsg = nil
        clearPendingSubmission()
        return
    end

    local rejected = lower:find("invalid code", 1, true)
        or lower:find("code is invalid", 1, true)
        or lower:find("code invalid", 1, true)
        or lower:find("expired", 1, true)
        or lower:find("already redeemed", 1, true)
        or lower:find("already used", 1, true)
        or lower:find("doesn't exist", 1, true)
        or lower:find("does not exist", 1, true)
        or lower:find("not found", 1, true)
        or lower:find("rejected", 1, true)

    if rejected and #_capturedParts > 0 then
        setStatus("✗ Invalid · waiting next word", COLORS.Gold)
        return
    end
end

function appendToBox(text)
    if not text or text == "" then return end
    if _lastWatchedBox and not isVisibleChain(_lastWatchedBox) then
        resetPasteCounter(); clearBoxWatchers()
    end

    local box = aceCodeBox()
    _capturedParts[#_capturedParts + 1] = text
    local combined = table.concat(_capturedParts)
    local cnt = #_capturedParts

    if box then
        _lastBox = box; watchBoxForBlankReset(box)
        local focus = UserInputService:GetFocusedTextBox() == box
        box.Text = combined
        if focus then
            pcall(function()
                local c = #combined + 1
                box.CursorPosition = c; box.SelectionStart = c
            end)
        end
    else
        setStatus("Captured · searching box...", COLORS.Gold)
    end

    setStatus(("Attempt %d · %s"):format(cnt, combined), COLORS.Green)
    flashCode(combined, COLORS.White)

    if _autoAccept then
        rememberPendingSubmission(box, combined, true)
        local ok, msg = typeAndSubmitCode(combined)
        if not ok then
            setStatus("Submit failed · "..tostring(msg), COLORS.Red)
        end
    end
end

