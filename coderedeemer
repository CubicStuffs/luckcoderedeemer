-- ANTI LAG
local antiLagConn = nil
local origLighting = nil
local textureBackup = {}
local antiLagApplied = false

local function backupProp(inst, prop, value)
    textureBackup[inst] = textureBackup[inst] or {}
    if textureBackup[inst][prop] == nil then
        textureBackup[inst][prop] = value
    end
end

local function wipeTextures()
    if not origLighting then
        origLighting = {
            GlobalShadows = Lighting.GlobalShadows,
            Brightness = Lighting.Brightness,
            Ambient = Lighting.Ambient,
            OutdoorAmbient = Lighting.OutdoorAmbient,
            FogEnd = Lighting.FogEnd,
            FogColor = Lighting.FogColor,
        }
    end
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 1e6
    local function process(obj)
        if obj:IsA("BasePart") or obj:IsA("MeshPart") or obj:IsA("UnionOperation")
        or obj:IsA("TrussPart") or obj:IsA("WedgePart") or obj:IsA("CornerWedgePart")
        or obj:IsA("SpawnLocation") or obj:IsA("Seat") or obj:IsA("VehicleSeat") then
            pcall(function()
                backupProp(obj, "Material", obj.Material)
                obj.Material = Enum.Material.SmoothPlastic
            end)
            for _, child in ipairs(obj:GetChildren()) do
                if child:IsA("Decal") or child:IsA("Texture") then
                    pcall(function()
                        backupProp(child, "Transparency", child.Transparency)
                        child.Transparency = 1
                    end)
                elseif child:IsA("SurfaceAppearance") then
                    pcall(function()
                        backupProp(child, "ColorMap", child.ColorMap); child.ColorMap = ""
                        backupProp(child, "NormalMap", child.NormalMap); child.NormalMap = ""
                        backupProp(child, "RoughnessMap", child.RoughnessMap); child.RoughnessMap = ""
                        backupProp(child, "MetalnessMap", child.MetalnessMap); child.MetalnessMap = ""
                    end)
                end
            end
        end
        if obj:IsA("Decal") or obj:IsA("Texture") then
            pcall(function()
                backupProp(obj, "Transparency", obj.Transparency); obj.Transparency = 1
            end)
        end
        if obj:IsA("SurfaceAppearance") then
            pcall(function()
                backupProp(obj, "ColorMap", obj.ColorMap); obj.ColorMap = ""
                backupProp(obj, "NormalMap", obj.NormalMap); obj.NormalMap = ""
                backupProp(obj, "RoughnessMap", obj.RoughnessMap); obj.RoughnessMap = ""
                backupProp(obj, "MetalnessMap", obj.MetalnessMap); obj.MetalnessMap = ""
            end)
        end
        if obj:IsA("ParticleEmitter") or obj:IsA("Trail")
        or obj:IsA("Smoke") or obj:IsA("Fire")
        or obj:IsA("Sparkles") or obj:IsA("Beam")
        or obj:IsA("Explosion") then
            pcall(function()
                backupProp(obj, "Enabled", obj.Enabled); obj.Enabled = false
            end)
        end
        if obj:IsA("Sky") then
            for _, prop in ipairs({"SkyboxBk","SkyboxDn","SkyboxFt","SkyboxLf","SkyboxRt","SkyboxUp"}) do
                pcall(function()
                    backupProp(obj, prop, obj[prop]); obj[prop] = ""
                end)
            end
        end
        if obj:IsA("Atmosphere") then
            pcall(function()
                backupProp(obj, "Density", obj.Density); obj.Density = 0
            end)
        end
    end
    for _, d in ipairs(workspace:GetDescendants()) do process(d) end
    for _, d in ipairs(Lighting:GetDescendants()) do process(d) end
    antiLagConn = workspace.DescendantAdded:Connect(function(d)
        task.wait(0.05)
        if antiLagApplied then process(d) end
    end)
end

local function restoreTextures()
    if antiLagConn then antiLagConn:Disconnect(); antiLagConn = nil end
    for inst, props in pairs(textureBackup) do
        if inst and inst.Parent then
            for prop, value in pairs(props) do
                pcall(function() inst[prop] = value end)
            end
        end
    end
    textureBackup = {}
    if origLighting then
        pcall(function()
            Lighting.GlobalShadows = origLighting.GlobalShadows
            Lighting.Brightness = origLighting.Brightness
            Lighting.Ambient = origLighting.Ambient
            Lighting.OutdoorAmbient = origLighting.OutdoorAmbient
            Lighting.FogEnd = origLighting.FogEnd
            Lighting.FogColor = origLighting.FogColor
        end)
        origLighting = nil
    end
end

