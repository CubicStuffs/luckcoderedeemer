local _lastStatusMsg = nil
local function col3Rich(col)
    if col == COLORS.Green then return CC.Green end
    if col == COLORS.Red then return CC.Red end
    if col == COLORS.Gold then return CC.Gold end
    if col == COLORS.Cyan then return CC.Cyan end
    if col == COLORS.TextDim then return CC.Dim end
    if col == COLORS.White then return CC.White end
    return string.format("rgb(%d,%d,%d)", math.floor(col.R*255+0.5), math.floor(col.G*255+0.5), math.floor(col.B*255+0.5))
end
function setStatus(msg, col)
    if not ConsoleOutput or not _enabled then return end
