do
    local drag, dS, pS, dragMoved
    local DRAG_THRESHOLD = 5
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            -- Skip if tapping buttons
            for _, b in ipairs({PowerBtn, MinBtn}) do
                local tp = b.AbsolutePosition
                local ts = b.AbsoluteSize
                local mx, my = input.Position.X, input.Position.Y
                if mx >= tp.X-8 and mx <= tp.X+ts.X+8 and my >= tp.Y-8 and my <= tp.Y+ts.Y+8 then return end
            end
            drag = true
            dragMoved = false
            dS = input.Position
            pS = Window.Position
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not drag then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dS
            if not dragMoved then
                if d.Magnitude < DRAG_THRESHOLD then return end
                dragMoved = true
            end
            Window.Position = UDim2.new(pS.X.Scale, pS.X.Offset + d.X, pS.Y.Scale, pS.Y.Offset + d.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            drag = false
        end
    end)
end

