-- REMOTE LISTENER
local function resolveNotify()
    if _G.PhiNotifyRemote then return _G.PhiNotifyRemote end
    local Pk = ReplicatedStorage:FindFirstChild("Packages")
    local Net = Pk and Pk:FindFirstChild("Net")
    if not Net then return nil end
    local gi = debug and (debug.getinfo or debug.info)
    if getgc and gi and getconnections then
        for _,d in ipairs(Net:GetDescendants()) do
            if d:IsA("RemoteEvent") then
                local ok, cs = pcall(getconnections, d.OnClientEvent)
                if ok then
                    for _,c in ipairs(cs) do
                        local f, fn = pcall(function() return c.Function end)
                        if f and type(fn) == "function" then
                            local i, info = pcall(gi, fn)
                            if i and tostring(info.short_src or info.source or ""):find("NotificationController",1,true) then return d end
                        end
                    end
                end
            end
        end
    end
    return nil
end
local function stripRich(t) if type(t)~="string" then return tostring(t) end; return (t:gsub("<[^>]->","")) end
local function tokenize(t) local w={} for word in t:gmatch("[%w_]+") do w[#w+1]=word end return w end
local collectBuf = {}
local function onAnnounce(...)
    local text = stripRich(tostring((...) or ""))
    text = text:match("^%s*(.-)%s*$") or ""
    if text == "" then return end
    if _riddleSolver and text:find("%s") then
        _riddleSeq += 1; solveRiddle(text, _riddleSeq); return
    end
    if text:find("%s") then return end
    for _,w in ipairs(tokenize(text)) do collectBuf[#collectBuf+1] = w end
    local parts = {}
    for i=1,math.min(#collectBuf, ACE_WORD_COUNT) do parts[i] = collectBuf[i] end
    if #collectBuf < ACE_WORD_COUNT then return end
    collectBuf = {}
    local cap = table.concat(parts)
    if cap == "" or _seen[cap] then return end
    _seen[cap] = true
    task.delay(1.25, function() _seen[cap] = nil end)
    appendToBox(cap)
end
local notifyRemote = resolveNotify()
local listenConn
if notifyRemote then
    if getgenv then local prev = getgenv().VFXNotifyConn; if prev then pcall(function() prev:Disconnect() end) end end
    listenConn = notifyRemote.OnClientEvent:Connect(function(...)
        if not _enabled then return end
        pcall(onAnnounce, ...)
    end)
    if getgenv then getgenv().VFXNotifyConn = listenConn end
end
if getgenv then
    getgenv().StopAura = function()
        if listenConn then pcall(function() listenConn:Disconnect() end); listenConn = nil end
        if getgenv().VFXNotifyConn then pcall(function() getgenv().VFXNotifyConn:Disconnect() end); getgenv().VFXNotifyConn = nil end
        if VFX_AntiLag then VFX_AntiLag(false) end
        if GUI then GUI:Destroy() end
    end
end
